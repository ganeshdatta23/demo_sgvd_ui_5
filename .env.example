# Backend API URL
# For local development: http://127.0.0.1:8000
# For production: https://your-backend-url.vercel.app
VITE_API_URL=http://127.0.0.1:8000

# Backend OpenAPI specification URL
# For production: https://your-backend-url.vercel.app/openapi.json
BE_OPENAPI_PATH=http://127.0.0.1:8000/openapi.json

# Google Gemini API Key (optional for location search)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
